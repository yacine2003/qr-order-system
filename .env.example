# Configuration d'environnement (exemple)
# Copiez ce fichier en .env et modifiez les valeurs

# Port du serveur
PORT=3000

# CORS (pour autoriser les requêtes depuis d'autres domaines)
# En production, remplacez par votre domaine
CORS_ORIGIN=*

# Environnement (development ou production)
NODE_ENV=development

# URL de base (pour la génération de QR codes)
BASE_URL=http://localhost:3000

# ============================================
# AUTHENTIFICATION ADMIN (IMPORTANT!)
# ============================================
# ⚠️  CHANGEZ CES IDENTIFIANTS EN PRODUCTION !
# Ces identifiants protègent l'accès à /admin et la gestion du menu

# Activer/désactiver l'authentification (true par défaut)
ADMIN_AUTH_ENABLED=true

# Identifiants admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 🔒 CONSEILS DE SÉCURITÉ :
# - Utilisez un mot de passe FORT en production (min 12 caractères)
# - Ne partagez JAMAIS ces identifiants
# - Ne commitez JAMAIS le fichier .env dans Git
