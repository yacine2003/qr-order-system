# Configuration d'environnement (exemple)
# Copiez ce fichier en .env et modifiez les valeurs

# Port du serveur
PORT=3000

# CORS (pour autoriser les requêtes depuis d'autres domaines)
# En production, remplacez par votre domaine
CORS_ORIGIN=*

# Environnement (development ou production)
NODE_ENV=development

# URL de base (pour la génération de QR codes)
BASE_URL=http://localhost:3000

# ============================================
# AUTHENTIFICATION ADMIN (pour les clients)
# ============================================
# ⚠️  CHANGEZ CES IDENTIFIANTS EN PRODUCTION !
# Ces identifiants protègent l'accès à /admin et la gestion du menu

# Activer/désactiver l'authentification (true par défaut)
ADMIN_AUTH_ENABLED=true

# Identifiants admin (à changer pour chaque client)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================
# AUTHENTIFICATION SUPERADMIN (développeurs uniquement)
# ============================================
# 🔒 Accès à la personnalisation visuelle (branding)
# ⚠️  RÉSERVÉ AUX DÉVELOPPEURS - GARDEZ CES IDENTIFIANTS ULTRA SECRETS !
# Ces identifiants donnent accès à /admin/branding.html

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMeToStrongPassword123!

# 🔒 CONSEILS DE SÉCURITÉ :
# - Admin : mot de passe différent pour CHAQUE client
# - Superadmin : mot de passe UNIQUE et ULTRA FORT (20+ caractères)
# - Ne partagez JAMAIS ces identifiants
# - Ne commitez JAMAIS le fichier .env dans Git
# - Utilisez un gestionnaire de mots de passe pour stocker le superadmin password
